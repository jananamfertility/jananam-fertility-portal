# Supabase project settings — find these in
# Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-side only, never expose to frontend
SUPABASE_JWT_SECRET=your-jwt-secret                # Project Settings > API > JWT Settings

# Comma-separated list of origins allowed to call this API
CORS_ORIGINS=http://localhost:5173

# Phase 2 — WhatsApp Cloud API webhook (leave as-is until phase 2 is activated)
WHATSAPP_VERIFY_TOKEN=choose-a-random-verification-string
WHATSAPP_APP_SECRET=your-meta-app-secret
