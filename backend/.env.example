# Supabase project settings — find these in
# Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-side only, never expose to frontend
SUPABASE_JWT_SECRET=your-jwt-secret                # Project Settings > API > JWT Settings

# Comma-separated list of origins allowed to call this API
CORS_ORIGINS=http://localhost:5173

# WhatsApp Cloud API — see README "WhatsApp bot setup" for how to get these
WHATSAPP_VERIFY_TOKEN=choose-a-random-verification-string
WHATSAPP_APP_SECRET=your-meta-app-secret
WHATSAPP_ACCESS_TOKEN=your-permanent-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-whatsapp-business-account-id
WHATSAPP_PUBLIC_NUMBER=919812345678

# AI bot — OpenRouter (https://openrouter.ai), calling a Claude model
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# Per-contact AI usage cap (see KNOWN_GAPS.md) — bounds OpenRouter spend/abuse
AI_MAX_CALLS_PER_WINDOW=20
AI_RATE_WINDOW_HOURS=24

# Country code (digits only) assumed for a bare 10-digit phone number typed
# into the portal, so it matches the same number arriving via WhatsApp.
DEFAULT_COUNTRY_CODE=91

# Optional — real email alert when the bot flags a message as needing human
# attention (in addition to the always-on in-portal alert). Leave blank to
# skip email and rely on the in-portal alert only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
STAFF_ALERT_EMAIL_TO=
